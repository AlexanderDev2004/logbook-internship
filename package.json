{
  "name": "logbook-internship",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --stage dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 execute logbook-db --local --file=./drizzle/init.sql",
    "db:remote": "wrangler d1 execute logbook-db --remote --file=./drizzle/init.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-router": "^1.130.0",
    "@tanstack/react-start": "^1.130.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "effect": "^3.17.0",
    "lucide-react": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "alchemy": "^0.78.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.40.0"
  },
  "packageManager": "pnpm@12.14.0"
}
